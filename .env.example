# Discord 機器人設定
# 注意：DISCORD_TOKEN 是在 Discord Developer Portal 的「Bot」分頁中點擊「Reset Token」產生的字串
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
DISCORD_CLIENT_ID=1562031172777938954
DISCORD_PUBLIC_KEY=872c8d90e80e0d6c3ee0fc801415ff76ce13551b31cf88fac6233670924ab819
COMMAND_PREFIX=!

# 語音錄音與回放設定
# 是否在機器人進入語音時自動全程錄音並存檔 (true/false)
AUTO_RECORD=false
# 前一分鐘對話回放緩衝區長度 (秒)
REPLAY_BUFFER_SECONDS=60

# 自動加入語音頻道設定
# 是否開啟自動加入 (true/false)
AUTO_JOIN_ENABLED=true
# 當語音頻道達到多少位非機器人成員時自動加入 (預設 2)
AUTO_JOIN_MIN_MEMBERS=2

# Google YouTube Music 認證設定 (選填，若使用 Google OAuth 模式時填寫)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
